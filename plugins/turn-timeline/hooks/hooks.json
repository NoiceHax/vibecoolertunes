{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/stamp.py"]
          },
          {
            "type": "command",
            "timeout": 5,
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/stamp.ps1"]
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/stamp.py"]
          },
          {
            "type": "command",
            "timeout": 5,
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/stamp.ps1"]
          }
        ]
      }
    ]
  }
}
