{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.js",
              "complete"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.js",
              "permission"
            ]
          }
        ]
      },
      {
        "matcher": "idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/dispatch.js",
              "question"
            ]
          }
        ]
      }
    ]
  }
}
