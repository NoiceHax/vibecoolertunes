# Shell scripts must keep LF endings. A CRLF .sh file fails on macOS and Linux
# with "bad interpreter: sh^M", and this repo is authored on Windows.
*.sh    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# PowerShell is Windows-only here, CRLF is fine and expected.
*.ps1   text eol=crlf

*.wav   binary
